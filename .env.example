# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Database. This one line picks the database:
#   SQLite (local, no server needed):  file:./adpulse.db
#   PostgreSQL (production):           postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=file:./adpulse.db

# Long random string used to sign admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public address of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
