# =====================================================================
# AdPulse Digital website: environment variables
# =====================================================================
# Variable names and descriptions only. NEVER put real values in this file.
#
# Local development: copy to .env.local (git-ignored). Nothing is required for
#   `npm run dev` except ADMIN_PASSWORD (to use /admin); content comes from src/data/*.json.
# Production (Hostinger): enter the values in hPanel → your Node.js app → Environment variables.
#   They must be present for the BUILD as well as at runtime (see HOSTINGER_DEPLOYMENT.md).
#
# Hostinger sets PORT itself; `npm start` (next start) uses it. Do not set PORT or NODE_ENV.
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
# Public address of the site, with https and no trailing slash (e.g. https://www.example.com).
# Used for SEO metadata, Open Graph and links in notification emails. Read at BUILD time.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------
# Content
# ---------------------------------------------------------------------
# Where website content is read from and saved to:
#   json = src/data/*.json (local development; read-only in production)
#   db   = PostgreSQL (production; required for admin editing)
#   api  = an external backend API (optional alternative; needs CONTENT_API_URL)
CONTENT_SOURCE=

# PostgreSQL connection string used by the WEBSITE. Required for CONTENT_SOURCE=db and for
# enquiry/newsletter forms in production. Use the provider's connection string with SSL enabled
# (sslmode=require). Neon: use the POOLED string (host contains "-pooler").
# The npm run db:* commands also use it, unless DIRECT_DATABASE_URL is set.
DATABASE_URL=

# Optional, YOUR COMPUTER ONLY (.env.local): direct (non-pooled) connection string used by the
# npm run db:* commands (migrate, seed, verify, export, restore) and drizzle-kit instead of
# DATABASE_URL. Neon recommends a direct connection for schema changes: in Neon > Connect,
# turn "Connection pooling" OFF. Never set this on Hostinger; the website ignores it.
DIRECT_DATABASE_URL=

# Maximum database connections per server process (optional, default 5).
DATABASE_POOL_MAX=

# External content backend (only with CONTENT_SOURCE=api).
# The site calls GET/PUT {CONTENT_API_URL}/{collection} with "Authorization: Bearer {CONTENT_API_TOKEN}".
CONTENT_API_URL=
CONTENT_API_TOKEN=

# Development / single-VPS only: allow admin saves to src/data/*.json when CONTENT_SOURCE=json.
# Leave EMPTY on Hostinger: the app folder is replaced on every deploy, so such saves would be lost.
# (Always ignored on Vercel.)
ALLOW_CONTENT_WRITES=

# ---------------------------------------------------------------------
# Admin panel (/admin, sign-in at /admin/login)
# ---------------------------------------------------------------------
# Admin password (required; without it nobody can sign in). Use a long random value.
# Changing it signs everyone out.
ADMIN_PASSWORD=

# Key that signs admin session cookies (recommended; long random value).
# If empty, a key is derived from ADMIN_PASSWORD. Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------
# Media library (uploaded images)
# ---------------------------------------------------------------------
# Where uploaded images are stored:
#   local = this computer's /public/uploads (development only; uploads are refused in production)
#   s3    = S3-compatible object storage: Cloudflare R2, AWS S3, Backblaze B2, … (production)
#   cloud = Vercel Blob (alternative; needs BLOB_READ_WRITE_TOKEN)
# Images shipped with the code (/public/images) work with every option.
MEDIA_STORAGE=

# --- S3-compatible storage (MEDIA_STORAGE=s3) ---
# Bucket name.
S3_BUCKET=
# Access key with read/write access to that bucket only
# (Cloudflare R2: Manage API tokens > "Object Read & Write", applied to this bucket only;
# use the Access Key ID and Secret Access Key, not the token value).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where browsers load uploaded images from. Leave EMPTY (recommended): the default "/media"
# keeps the bucket PRIVATE and the website serves each image itself at
# /media/uploads/<file> (src/app/media/[...key]/route.ts), on the site's own domain.
# No public bucket, r2.dev URL or DNS change is needed.
# Only if you later serve the bucket directly: its https:// public or custom-domain URL,
# no trailing slash (e.g. https://media.example.com). Image URLs already saved in the content
# keep the old address, so do not change this after images have been uploaded.
S3_PUBLIC_URL=
# API endpoint. Required for anything other than AWS
# (Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com). Leave empty for AWS S3.
S3_ENDPOINT=
# Region (R2: auto; AWS: e.g. ap-south-1). Default: auto.
S3_REGION=
# "true" only if your provider requires path-style URLs (e.g. MinIO). Default: false.
S3_FORCE_PATH_STYLE=

# --- Vercel Blob (MEDIA_STORAGE=cloud) ---
# Read/write token of a Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------
# Forms: free audit requests and newsletter sign-ups
# ---------------------------------------------------------------------
# Submissions are always saved to PostgreSQL (DATABASE_URL) first. Email is optional:
# while the three Resend values below are empty, enquiries are still saved and listed in
# /admin/enquiries with notification status "not configured".

# Resend API key (resend.com → API Keys; "sending access" is enough).
RESEND_API_KEY=
# Who receives new audit requests. Several addresses: comma-separated.
ENQUIRY_NOTIFICATION_EMAIL=
# Sender on a domain verified in Resend, e.g. AdPulse Website <notifications@your-domain>.
ENQUIRY_FROM_EMAIL=

# Secret used to hash visitor IPs for rate limiting (raw IPs are never stored).
# Long random value; set it in production.
ENQUIRY_HASH_SALT=
