# Copy this file to .env.local and fill in the values you need.
# Nothing here is required to run the site locally with `npm run dev` (it uses src/data/*.json).
# Never commit real values: .env.local is git-ignored. On Vercel, set them in Project → Settings → Environment Variables.

# ---------------------------------------------------------------
# Content source
#   json = src/data/*.json (default; local development)
#   db   = PostgreSQL database (production). Needs DATABASE_URL.
#   api  = an external backend API (CONTENT_API_URL), optional alternative
# ---------------------------------------------------------------
CONTENT_SOURCE=json

# PostgreSQL connection string (CONTENT_SOURCE=db and the npm run db:* commands).
# Neon / Vercel: use the POOLED connection string (host contains "-pooler"), with ?sslmode=require
# e.g. postgres://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Max connections per server instance (keep small on serverless). Default 5.
DATABASE_POOL_MAX=5

# External backend (only with CONTENT_SOURCE=api). The site calls GET {CONTENT_API_URL}/{collection}
CONTENT_API_URL=
CONTENT_API_TOKEN=

# ---------------------------------------------------------------
# Admin panel (/admin) — sign-in page at /admin/login
# ADMIN_PASSWORD is required in development AND production. Without it nobody can sign in.
# Put the real value in .env.local (git-ignored) or the hosting environment, never in this file.
# Use a long random password. Changing it signs everyone out.
# ADMIN_SESSION_SECRET (optional): separate key for signing session cookies; change it to sign everyone out.
# ---------------------------------------------------------------
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=
# Only for CONTENT_SOURCE=json on a single server with a writable disk (e.g. a VPS).
# Not needed with CONTENT_SOURCE=db.
ALLOW_CONTENT_WRITES=false

# ---------------------------------------------------------------
# Media storage (src/services/media/storage.ts)
#   local = files on this server's disk (development / single server)
#   cloud = Vercel Blob (production on Vercel). Needs BLOB_READ_WRITE_TOKEN.
# ---------------------------------------------------------------
MEDIA_STORAGE=local
# Added automatically by Vercel when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------
# Forms / enquiries (src/services/enquiries)
# Submissions are saved to PostgreSQL (DATABASE_URL) first, then AdPulse is emailed via Resend.
# Without DATABASE_URL in development they go to .data/enquiries.dev.json (git-ignored, dev only).
# ---------------------------------------------------------------
# Resend API key (resend.com → API Keys). Sending access only is enough.
RESEND_API_KEY=
# Who receives new audit requests. Several: comma-separated.
ENQUIRY_NOTIFICATION_EMAIL=sales@example.com
# Sender, on your Resend-verified domain, e.g. "AdPulse Website <notifications@yourdomain.com>"
ENQUIRY_FROM_EMAIL=AdPulse Website <notifications@example.com>
# Long random string used to hash visitor IPs for rate limiting (raw IPs are never stored).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENQUIRY_HASH_SALT=

# Public site URL (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
